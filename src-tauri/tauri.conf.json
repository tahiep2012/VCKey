{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCKeys",
  "version": "3.0.9",
  "identifier": "com.vckeys.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VCKeys 3.0.9 - Bảng Điều Khiển",
        "width": 520,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "shadow": true
      },
      {
        "label": "candidate",
        "title": "VCKeys Candidate",
        "width": 420,
        "height": 65,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "osd",
        "title": "VCKeys OSD",
        "width": 320,
        "height": 45,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
